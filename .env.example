# Copy to .env and adjust for your VM. Never commit .env.
#
# Absolute path to this repo (host). In API/cleanup containers SANDBOX_ROOT is overridden to /sandbox.
SANDBOX_ROOT=/home/ubuntu/devops-sandbox

# Published port for the edge Nginx (env routes: http://127.0.0.1:${NGINX_HTTP_PORT}/env/<ENV_ID>/...)
NGINX_HTTP_PORT=80

# Docker container names (set in docker-compose.yml — must match)
NGINX_CONTAINER_NAME=sandbox-nginx
API_CONTAINER_NAME=sandbox-api

# Demo app image (built locally)
DEMO_IMAGE=sandbox-demo-app:latest

# Control API
API_HOST=0.0.0.0
API_PORT=9090

# Printed by create_env.sh in the "URL:" line (defaults to 127.0.0.1).
PUBLIC_HOST=127.0.0.1
